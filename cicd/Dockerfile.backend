FROM python:3.12-slim
# Pick up Debian security fixes (e.g. zlib1g) that are newer than the base image.
# The dated echo makes this step's text unique, so the builder cannot reuse a cached
# result from before the fixes were published - bump the date to force a fresh run.
RUN echo "security refresh 2026-11-12" \
    && apt-get update && apt-get upgrade -y && apt-get install -y --only-upgrade zlib1g \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt ./requirements.txt
# --only-binary: python:3.12-slim has no C compiler, so a package without a wheel would
# otherwise attempt a source build and fail deep in a cryptic compile.
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.txt

COPY backend/ ./

# Substrait requires the backend on port 8000, serving GET /health.
EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
